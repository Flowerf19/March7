# =================================================================
# Bé Bảy / March7 — environment configuration
# Copy to .env and fill in real values.  Anything that rarely changes
# per deployment lives in code (twin/shared/config/settings.py).
# Both agent Compose files use `env_file: ../../.env` for shared config
# but never bind-mount the full .env into containers.
# =================================================================

# --- Discord bots (each container sees only its OWN token) ---
# Peer credential isolation is via explicit blank `environment:` overrides
# (compose precedence: environment > env_file): march7 blanks
# DISCORD_EVERNIGHT_TOKEN, evernight blanks DISCORD_MARCH7_TOKEN.
DISCORD_MARCH7_TOKEN=your_march7_discord_bot_token
DISCORD_MARCH7_CLIENT_ID=your_march7_discord_client_id
DISCORD_EVERNIGHT_TOKEN=your_evernight_discord_bot_token
DISCORD_EVERNIGHT_CLIENT_ID=your_evernight_discord_client_id

# --- Gateway ---
GATEWAY_ENABLED_PLATFORMS=discord
DISCORD_GATEWAY_ENABLED=true
SYNC_COMMANDS=0
MESSAGE_DEBOUNCE_SECONDS=3.5

# --- Agent identity ---
MARCH7_A2A_PORT=8000
MARCH7_REDIS_DB=0
MARCH7_PERSONA_PATH=twin/march7/personas
EVERNIGHT_A2A_PORT=8001
EVERNIGHT_REDIS_DB=1
EVERNIGHT_PERSONA_PATH=twin/evernight/personas
# Explicit owner platform user id. Empty means unknown -> deny (fail-closed).
# No default and no baked-in id: owner authority must be configured.
EVERNIGHT_OWNER_USER_ID=

# --- Agent-to-agent endpoints (Docker hostnames) ---
EVERNIGHT_A2A_URL=http://evernight:8001
MARCH7_URL=http://march7:8000
# Mandatory HMAC shared secret for protected A2A RPC/streams/DM routes.
# Both agents must hold the SAME value via this shared .env. Missing/empty
# denies every protected route (only GET /.well-known/agent.json and
# GET /health stay public). Leave empty here; put a real random value in
# .env only (never commit). No fake static defaults.
A2A_SHARED_SECRET=

# --- Evernight background workers ---
SELF_HEAL_ENABLED=true
SELF_HEAL_INTERVAL=30
SELF_HEAL_TIMEOUT=10
POLL_INTERVAL=60

# --- Shared infrastructure ---
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
# T2 timeline RediSearch indexes must live on Redis DB 0.
TIMELINE_REDIS_DB=0
T1_CONTEXT_MAX_TOKENS=1800
T1_CONTEXT_MAX_MESSAGES=32
CODEBOX_API_URL=http://codebox:8069
BASH_EXECUTOR_URL=http://bash-executor:8374
BASH_EXECUTOR_TIMEOUT=30

# --- LLM provider: "gemini" or "openai" (OpenAI-compatible covers OpenRouter,
#     LM Studio, Qwen compatible-mode, etc. via OPENAI_API_URL) ---
LLM_PROVIDER=openai
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TOP_P=0.9
LLM_TOP_K=40
LLM_FREQUENCY_PENALTY=0.4
LLM_PRESENCE_PENALTY=0.1
LLM_REQUEST_TIMEOUT=120
LLM_CONNECT_TIMEOUT=10

# OpenAI-compatible endpoint
OPENAI_API_KEY=dummy-key
OPENAI_API_URL=http://host.docker.internal:1234/v1
OPENAI_MODEL=gemma4-e4b-max

# Gemini (only needed when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# --- Embeddings (local Harrier q4 ONNX only, no API) ---
# Sole backend: harrier-oss-v1-270m q4 ONNX, exactly 640 dims.
# Pull once: python scripts/pull_harrier_model.py (206MB into models/).
# Legacy 1024-dim vectors must be migrated (scripts/migrate_t2_harrier.py),
# never padded/trimmed into 640.
HARRIER_MODEL_DIR=models/harrier-q4
EMBEDDING_VECTOR_SIZE=640
# Harrier is instruction-aware & ASYMMETRIC: the QUERY side gets an
# instruct wrapper (one line; `\n` is unescaped to a real newline at load),
# the PASSAGE side stays raw — leave empty. Changing only the query prefix
# needs NO reindex.
EMBEDDING_QUERY_PREFIX="Instruct: Given a user message, retrieve relevant memory summaries about the user and past conversation\nQuery: "
EMBEDDING_PASSAGE_PREFIX=
# Relevance gate for T2 semantic recall — drop hits below this cosine.
# Harrier default 0.60 (2026-09-30, real harrier-oss-v1-270m q4 ONNX with
# deployed prefixes; scripts/calibrate_t2.py --offline labeled set:
# negatives peak below, clear positives clear it; vague sub-gate queries
# return no memory rather than wrong memory). Pre-Harrier values
# (0.0/0.35/0.42/0.45) admit cross-topic noise — below-default explicit
# values log a warning but are still respected.
T2_MIN_COSINE=0.60
# Same-day diary merge gate. Harrier default 0.75 (2026-09-30 offline set:
# same-event follow-ups 0.82-0.93 all merge, cross-topic max 0.71 blocked).
# Missed merge safely appends; a false merge glues unrelated topics.
# Legacy Qwen-era 0.60 false-merges with Harrier.
T2_MERGE_MIN_COSINE=0.75
# Merged diary doc char cap — beyond this a new doc is appended instead.
T2_MERGE_MAX_CHARS=1500
# Archive raw T1 entries to t1:archive:{scope}:{scope_id}:{day} on trim
# (cold list, TTL below) instead of hard-deleting them.
T1_ARCHIVE_ENABLED=true
T1_ARCHIVE_TTL_DAYS=90

# --- Tavily (web search tool) ---
TAVILY_API_KEY=your_tavily_api_key
TAVILY_MCP_URL=https://mcp.tavily.com/mcp
TAVILY_TIMEOUT=30

# --- System Gateway (native host boundary + containers) ---
# Request HMAC key, DISTINCT from the private owner approval key FILE below.
# Shared with agent containers via this .env (env_file); the native service
# reads env or SYSTEM_GATEWAY_SHARED_SECRET_FILE. Empty fails closed.
# Generate via `system-gateway pair` outside the repo; never commit a value.
# Must differ from the approval key (equal credentials are rejected).
SYSTEM_GATEWAY_SHARED_SECRET=
# Raw shell is DENIED by default; explicit opt-in still needs a real owner
# grant per command. Missing owner/key fails closed. Native default false.
SYSTEM_GATEWAY_RAW_SHELL=false
# Owner approval key: FILE path ONLY. The key VALUE is never inline, never
# in env, never in the shared repo .env. Provisioned host-private outside
# the repo via `system-gateway pair` (POSIX 0600, owner-only). On Windows,
# manually restrict NTFS ACLs to the service/owner account: chmod alone is
# insufficient (live Windows ACL setup unverified). Missing key denies.
# Native default (services/system_gateway/paths.py, env override wins):
#   Linux root: /etc/system-gateway/approval_secret, else ~/.config/system-gateway/approval_secret
#   macOS: ~/Library/Application Support/system-gateway/approval_secret
#   Windows admin: %ProgramData%\system-gateway\approval_secret, else %LOCALAPPDATA%\system-gateway\approval_secret
# Evernight container override (docker/evernight/docker-compose.yml) sets
# SYSTEM_GATEWAY_APPROVAL_SECRET_FILE=/run/secrets/system_gateway_approval
# (read-only mount, Evernight only; March7 blanks it). Do NOT set the shared
# .env to that container-only path — the native host needs a host path.
# Uncomment to override the native host path (nonsecret path only):
# SYSTEM_GATEWAY_APPROVAL_SECRET_FILE=/home/YOU/.config/system-gateway/approval_secret
# HOST-only compose mount override (nonsecret path): host source for the
# read-only Evernight mount. Compose default is
# ${SYSTEM_GATEWAY_APPROVAL_SECRET_HOST_PATH:-${HOME}/.config/system-gateway/approval_secret}.
# Root installs: point to a UID-readable private COPY of the /etc key
# (a root 0600 key must NOT be made world-readable).
# SYSTEM_GATEWAY_APPROVAL_SECRET_HOST_PATH=/home/YOU/.config/system-gateway/approval_secret
# Optional native state (outside repo, secure defaults; usually unset):
# SYSTEM_GATEWAY_STATE_DIR default is Linux root /etc/system-gateway else
# ~/.config/system-gateway (macOS/Windows per paths.py); ledger default is
# <state-dir>/approval_ledger.db (":memory:" is test-only, never default).
# SYSTEM_GATEWAY_STATE_DIR=/home/YOU/.config/system-gateway
# SYSTEM_GATEWAY_APPROVAL_LEDGER_FILE=/home/YOU/.config/system-gateway/approval_ledger.db

# --- Runtime ---
LOG_LEVEL=INFO

# --- Tracing (LangSmith, optional) ---
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=march7-bot
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

EMBEDDING_TRACE_LOG_ENABLED=true
EMBEDDING_TRACE_LOG_PATH=logs/embedding_trace.jsonl
